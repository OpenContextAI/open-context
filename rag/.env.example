# OpenContext RAG Service - Local Development Configuration

# FastAPI Settings
APP_NAME=OpenContext RAG Service
APP_VERSION=1.0.0
API_PREFIX=/api/v1

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=document_chunks_index

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=bge-m3:latest

# Processing Configuration
EMBEDDING_BATCH_SIZE=10
SNIPPET_MAX_LENGTH=50

# Search Configuration (Hybrid Search Weights)
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7

# Content Retrieval
DEFAULT_MAX_TOKENS=25000
TOKENIZER=tiktoken-cl100k_base
